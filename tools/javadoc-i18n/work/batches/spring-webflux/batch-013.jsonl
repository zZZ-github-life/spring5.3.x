{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::24::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 24, "start": 25, "end": 26, "indent": "", "lines": ["Representation of WebSocket \"close\" status codes and reasons. Status codes", "in the 1xxx range are pre-defined by the protocol."]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::35::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 35, "start": 36, "end": 37, "indent": "\t", "lines": ["\"1000 indicates a normal closure, meaning that the purpose for which the connection", "was established has been fulfilled.\""]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::41::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 41, "start": 42, "end": 43, "indent": "\t", "lines": ["\"1001 indicates that an endpoint is \"going away\", such as a server going down or a", "browser having navigated away from a page.\""]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::47::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 47, "start": 48, "end": 49, "indent": "\t", "lines": ["\"1002 indicates that an endpoint is terminating the connection due to a protocol", "error.\""]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::53::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 53, "start": 54, "end": 56, "indent": "\t", "lines": ["\"1003 indicates that an endpoint is terminating the connection because it has", "received a type of data it cannot accept (e.g., an endpoint that understands only", "text data MAY send this if it receives a binary message).\""]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::63::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 63, "start": 64, "end": 66, "indent": "\t", "lines": ["\"1005 is a reserved value and MUST NOT be set as a status code in a Close control", "frame by an endpoint. It is designated for use in applications expecting a status", "code to indicate that no status code was actually present.\""]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::70::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 70, "start": 71, "end": 74, "indent": "\t", "lines": ["\"1006 is a reserved value and MUST NOT be set as a status code in a Close control", "frame by an endpoint. It is designated for use in applications expecting a status", "code to indicate that the connection was closed abnormally, e.g., without sending", "or receiving a Close control frame.\""]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::78::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 78, "start": 79, "end": 81, "indent": "\t", "lines": ["\"1007 indicates that an endpoint is terminating the connection because it has", "received data within a message that was not consistent with the type of the message", "(e.g., non-UTF-8 [RFC3629] data within a text message).\""]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::85::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 85, "start": 86, "end": 89, "indent": "\t", "lines": ["\"1008 indicates that an endpoint is terminating the connection because it has", "received a message that violates its policy. This is a generic status code that can", "be returned when there is no other more suitable status code (e.g., 1003 or 1009)", "or if there is a need to hide specific details about the policy.\""]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::93::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 93, "start": 94, "end": 95, "indent": "\t", "lines": ["\"1009 indicates that an endpoint is terminating the connection because it has", "received a message that is too big for it to process.\""]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::99::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 99, "start": 100, "end": 105, "indent": "\t", "lines": ["\"1010 indicates that an endpoint (client) is terminating the connection because it", "has expected the server to negotiate one or more extension, but the server didn't", "return them in the response message of the WebSocket handshake. The list of", "extensions that are needed SHOULD appear in the /reason/ part of the Close frame.", "Note that this status code is not used by the server, because it can fail the", "WebSocket handshake instead.\""]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::109::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 109, "start": 110, "end": 111, "indent": "\t", "lines": ["\"1011 indicates that a server is terminating the connection because it encountered", "an unexpected condition that prevented it from fulfilling the request.\""]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::115::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 115, "start": 116, "end": 117, "indent": "\t", "lines": ["\"1012 indicates that the service is restarted. A client may reconnect, and if it", "chooses to do, should reconnect using a randomized delay of 5 - 30s.\""]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::121::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 121, "start": 122, "end": 124, "indent": "\t", "lines": ["\"1013 indicates that the service is experiencing overload. A client should only", "connect to a different IP (when there are multiple for the target) or reconnect to", "the same IP upon user action.\""]}
{"id": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java::128::0", "file": "spring-webflux/src/main/java/org/springframework/web/reactive/socket/CloseStatus.java", "module": "spring-webflux", "block_start": 128, "start": 129, "end": 132, "indent": "\t", "lines": ["\"1015 is a reserved value and MUST NOT be set as a status code in a Close control", "frame by an endpoint. It is designated for use in applications expecting a status", "code to indicate that the connection was closed due to a failure to perform a TLS", "handshake (e.g., the server certificate can't be verified).\""]}
