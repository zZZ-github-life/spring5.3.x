{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::25::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 25, "start": 26, "end": 27, "indent": "", "lines": ["Represents a WebSocket close status code and reason. Status codes in the 1xxx range are", "pre-defined by the protocol. Optionally, a status code may be sent with a reason."]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::25::1", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 25, "start": 29, "end": 30, "indent": "", "lines": ["<p>See <a href=\"https://tools.ietf.org/html/rfc6455#section-7.4.1\">RFC 6455, Section 7.4.1", "\"Defined Status Codes\"</a>."]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::40::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 40, "start": 41, "end": 42, "indent": "\t", "lines": ["\"1000 indicates a normal closure, meaning that the purpose for which the connection", "was established has been fulfilled.\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::46::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 46, "start": 47, "end": 48, "indent": "\t", "lines": ["\"1001 indicates that an endpoint is \"going away\", such as a server going down or a", "browser having navigated away from a page.\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::52::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 52, "start": 53, "end": 54, "indent": "\t", "lines": ["\"1002 indicates that an endpoint is terminating the connection due to a protocol", "error.\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::58::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 58, "start": 59, "end": 61, "indent": "\t", "lines": ["\"1003 indicates that an endpoint is terminating the connection because it has", "received a type of data it cannot accept (e.g., an endpoint that understands only", "text data MAY send this if it receives a binary message).\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::68::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 68, "start": 69, "end": 71, "indent": "\t", "lines": ["\"1005 is a reserved value and MUST NOT be set as a status code in a Close control", "frame by an endpoint. It is designated for use in applications expecting a status", "code to indicate that no status code was actually present.\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::75::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 75, "start": 76, "end": 79, "indent": "\t", "lines": ["\"1006 is a reserved value and MUST NOT be set as a status code in a Close control", "frame by an endpoint. It is designated for use in applications expecting a status", "code to indicate that the connection was closed abnormally, e.g., without sending", "or receiving a Close control frame.\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::83::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 83, "start": 84, "end": 86, "indent": "\t", "lines": ["\"1007 indicates that an endpoint is terminating the connection because it has", "received data within a message that was not consistent with the type of the message", "(e.g., non-UTF-8 [RFC3629] data within a text message).\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::90::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 90, "start": 91, "end": 94, "indent": "\t", "lines": ["\"1008 indicates that an endpoint is terminating the connection because it has", "received a message that violates its policy. This is a generic status code that can", "be returned when there is no other more suitable status code (e.g., 1003 or 1009)", "or if there is a need to hide specific details about the policy.\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::98::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 98, "start": 99, "end": 100, "indent": "\t", "lines": ["\"1009 indicates that an endpoint is terminating the connection because it has", "received a message that is too big for it to process.\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::104::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 104, "start": 105, "end": 110, "indent": "\t", "lines": ["\"1010 indicates that an endpoint (client) is terminating the connection because it", "has expected the server to negotiate one or more extension, but the server didn't", "return them in the response message of the WebSocket handshake. The list of", "extensions that are needed SHOULD appear in the /reason/ part of the Close frame.", "Note that this status code is not used by the server, because it can fail the", "WebSocket handshake instead.\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::114::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 114, "start": 115, "end": 116, "indent": "\t", "lines": ["\"1011 indicates that a server is terminating the connection because it encountered", "an unexpected condition that prevented it from fulfilling the request.\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::120::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 120, "start": 121, "end": 122, "indent": "\t", "lines": ["\"1012 indicates that the service is restarted. A client may reconnect, and if it", "chooses to do, should reconnect using a randomized delay of 5 - 30s.\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::126::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 126, "start": 127, "end": 129, "indent": "\t", "lines": ["\"1013 indicates that the service is experiencing overload. A client should only", "connect to a different IP (when there are multiple for the target) or reconnect to", "the same IP upon user action.\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::133::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 133, "start": 134, "end": 137, "indent": "\t", "lines": ["\"1015 is a reserved value and MUST NOT be set as a status code in a Close control", "frame by an endpoint. It is designated for use in applications expecting a status", "code to indicate that the connection was closed due to a failure to perform a TLS", "handshake (e.g., the server certificate can't be verified).\""]}
{"id": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java::141::0", "file": "spring-websocket/src/main/java/org/springframework/web/socket/CloseStatus.java", "module": "spring-websocket", "block_start": 141, "start": 142, "end": 145, "indent": "\t", "lines": ["A status code for use within the framework that indicates a session has", "become unreliable (e.g. timed out while sending a message) and extra", "care should be exercised, e.g. avoid sending any further data to the", "client that may be done during normal shutdown."]}
